{
  "name": "mondiro-toolbox",
  "version": "1.0.0",
  "description": "Mondiro Toolbox — gop cac tool xu ly anh/Spine cua Mondiro thanh 1 app duy nhat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Mondiro",
  "license": "ISC",
  "dependencies": {
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mondiro.toolbox",
    "productName": "Mondiro Toolbox",
    "files": [
      "main.js",
      "lib/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
